[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/hud.gd" id="1_hud"]
[ext_resource type="Texture2D" path="res://Items/Fruits/Apple.png" id="2_apple"]
[ext_resource type="PackedScene" path="res://scenes/ui/pause_menu.tscn" id="3_pause"]
[ext_resource type="PackedScene" path="res://scenes/ui/level_complete.tscn" id="4_complete"]
[ext_resource type="PackedScene" path="res://scenes/ui/game_over.tscn" id="5_gameover"]

[node name="HUD" type="CanvasLayer"]
process_mode = 3
script = ExtResource("1_hud")

[node name="MarginContainer" type="MarginContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 8

[node name="TopBar" type="HBoxContainer" parent="MarginContainer"]
layout_mode = 2
size_flags_vertical = 0
theme_override_constants/separation = 16

[node name="HealthContainer" type="HBoxContainer" parent="MarginContainer/TopBar"]
layout_mode = 2
theme_override_constants/separation = 3

[node name="HeroBadge" type="HBoxContainer" parent="MarginContainer/TopBar"]
layout_mode = 2

[node name="HeroLabel" type="Label" parent="MarginContainer/TopBar/HeroBadge"]
modulate = Color(0.9, 0.9, 0.4, 1)
layout_mode = 2
theme_override_font_sizes/font_size = 11
text = "Hero"

[node name="Spacer" type="Control" parent="MarginContainer/TopBar"]
layout_mode = 2
size_flags_horizontal = 3

[node name="FruitContainer" type="HBoxContainer" parent="MarginContainer/TopBar"]
layout_mode = 2

[node name="FruitIcon" type="TextureRect" parent="MarginContainer/TopBar/FruitContainer"]
custom_minimum_size = Vector2(16, 16)
layout_mode = 2
texture = ExtResource("2_apple")
stretch_mode = 5

[node name="FruitLabel" type="Label" parent="MarginContainer/TopBar/FruitContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 11
text = "0 / 0"

[node name="TimerLabel" type="Label" parent="MarginContainer/TopBar"]
layout_mode = 2
theme_override_font_sizes/font_size = 11
text = "00:00.00"

[node name="PauseButton" type="Button" parent="MarginContainer/TopBar"]
layout_mode = 2
text = "II"

[node name="PauseMenu" parent="." instance=ExtResource("3_pause")]
visible = false

[node name="LevelCompleteMenu" parent="." instance=ExtResource("4_complete")]
visible = false

[node name="GameOverMenu" parent="." instance=ExtResource("5_gameover")]
visible = false
